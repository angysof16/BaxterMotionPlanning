<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="baxter_base">
  <xacro:macro name="baxter_base">

    <link name="world" />

    <!-- PEDESTAL -->
    <link name="base_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://baxter_description/meshes/base/PEDESTAL.STL" scale="1 1 1" />
        </geometry>
        <material name="darkgray">
          <color rgba=".2 .2 .2 1" />
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://baxter_description/meshes/base/pedestal_link_collision.STL"
            scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <mass value="60.86397744" />
        <inertia ixx="5.0635929" ixy="0.00103417" ixz="0.80199628" iyy="6.08689388"
          iyz="0.00105311" izz="4.96191932" />
      </inertial>
    </link>

    <!-- BASE JOINT -->
    <joint name="world_to_base" type="fixed">
      <parent link="world" />
      <child link="base_link" />
      <origin xyz="0 0 .924" rpy="0 0 0" />
    </joint>

  </xacro:macro>
</robot>
