<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="baxter_head">
  <xacro:macro name="baxter_head">

    <!-- Head -->
    <link name="head">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://baxter_description/meshes/head/H0.STL" />
        </geometry>
        <material name="darkgray">
          <color rgba=".2 .2 .2 1" />
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://baxter_description/meshes/head/H0.STL" />
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <mass value="1.5" />
        <inertia ixx="0.004641" ixy="0.000159" ixz="0.000242" iyy="0.003295" iyz="-0.001324"
          izz="0.003415" />
      </inertial>
    </link>

    <link name="screen">
      <visual>
        <origin rpy="1.57079632679 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://baxter_description/meshes/head/H1.STL" />
        </geometry>
        <material name="darkred">
          <color rgba=".5 .1 .1 1" />
        </material>
      </visual>
      <collision>
        <origin rpy="1.57079632679 0 0" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://baxter_description/meshes/head/H1.STL" />
        </geometry>
      </collision>
      <inertial>
        <origin rpy="1.57079632679 0 0" xyz="0 0 0" />
        <mass value="1" />
        <inertia ixx="0.004006" ixy="0.000230" ixz="0.000002" iyy="0.002800" iyz="0.000029"
          izz="0.001509" />
      </inertial>
    </link>

    <link name="hat">
      <visual>
        <origin rpy="0 0 1.5708" xyz="0 0 -.08" />
        <geometry>
          <mesh filename="package://baxter_description/meshes/head/HAT.STL" scale=".01 .01 .01" />
        </geometry>
        <material name="hat">
          <color rgba=".875 .84 .757 1" />
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 1.5708" xyz="0 0 -.08" />
        <geometry>
          <mesh filename="package://baxter_description/meshes/head/HAT.STL" scale=".01 .01 .01" />
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 1.5708" xyz="0 0 -.08" />
        <mass value=".3" />
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01" />
      </inertial>
    </link>

    <!-- HEAD JOINTS -->
    <joint name="head_screen" type="fixed">
      <origin rpy="0 0 0" xyz=".07 0 0" />
      <parent link="head" />
      <child link="screen" />
    </joint>

    <joint name="torso_head" type="revolute">
      <parent link="torso" />
      <child link="head" />
      <origin xyz=".062 0 .6875" rpy="0 0 0" />
      <axis xyz="0 0 1" />
      <limit lower="-0.7854" upper="0.7854" effort="50" velocity="1.5" />
    </joint>

    <joint name="head_hat" type="fixed">
      <parent link="head" />
      <child link="hat" />
      <origin rpy="0 0 0" xyz="0 0 .18" />
    </joint>

  </xacro:macro>
</robot>
